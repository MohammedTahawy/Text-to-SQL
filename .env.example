# ==============================================================================
# Executive Text-to-SQL AI Copilot - Environment Configuration
# Author: Mohamed Tahawy (https://github.com/MohammedTahawy)
# ==============================================================================

# Application Environment (development / production / test)
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Service Authentication (Header: X-AI-API-KEY)
AI_SERVICE_API_KEY=enterprise_copilot_demo_key_2026

# Groq Cloud API Credentials (LLM Inference & Whisper v3 Turbo Speech-to-Text)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Database Configuration (SQLite by default for instant local setup)
DB_DIALECT=sqlite
SQLITE_PATH=demo_enterprise.db

# Optional Enterprise Database Connections (MySQL / MariaDB / PostgreSQL)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=enterprise_erp
# DB_USER=enterprise_readonly
# DB_PASS=your_secure_password

# Redis Caching (Optional - for query caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# WhatsApp Cloud API & CRM Webhook (Optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=enterprise_copilot_whatsapp_webhook_2026
