# ==============================================================================
# InfoSas AI Intelligence Microservice - Environment Configuration Template
# Copy this file to `.env` and supply your actual credentials.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# --- 1. General Runtime Settings ---
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Internal shared secret for authenticating requests between Laravel and FastAPI
# Include this token in the 'X-AI-API-KEY' HTTP request header
AI_SERVICE_API_KEY=your_secure_internal_token_here

# --- 2. LLM Provider Configurations ---
# Active provider: 'groq' (recommended for ultra-low latency) or 'openai'
DEFAULT_LLM_PROVIDER=groq

# Groq API Settings (Get your free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_CONCURRENCY=3

# OpenAI API Settings (Optional fallback provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Settings (Optional future provider)
GEMINI_API_KEY=

# --- 3. Database Configurations ---
# DB_TYPE: 'sqlite' for quick local testing, 'mysql' for production ERP
DB_TYPE=sqlite

# Local SQLite database filename (e.g. demo_enterprise.db)
SQLITE_PATH=demo_enterprise.db

# Production MySQL Settings (active when DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_enterprise_db_name
DB_USER=your_readonly_user
DB_PASSWORD=your_strong_readonly_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- 4. WhatsApp Business Cloud API Settings ---
# Registered Meta Developer credentials for WhatsApp Copilot
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token

# --- 5. Redis Cache Settings ---
# Used for semantic query caching
REDIS_URL=redis://localhost:6379/0
